      "border": "{border.width.hairline} solid {color.{theme}.border.subtle}",
      "hoverBackground": "{color.{theme}.surface.subtle}",
      "hoverShadow": "{shadow.{theme}.sm}"
    },
    "button": {"primaryBackground": "{color.{theme}.interactive.primary}", "primaryForeground": "{color.{theme}.interactive.onPrimary}"},
    "input": {"background": "{color.{theme}.surface.default}", "border": "{color.{theme}.border.strong}"},
    "navigation": {"selectedBackground": "{color.{theme}.surface.muted}", "selectedMarker": "{color.{theme}.interactive.accent}"},
    "alert": {"information": "{color.{theme}.state.information}", "error": "{color.{theme}.state.danger}"},
    "focus": {"ringColor": "{color.{theme}.interactive.focus}", "ringWidth": "{border.width.focus}", "offset": "{border.focusOffset}"},
    "upload": {"borderColor": "{color.{theme}.border.strong}", "borderStyle": "{border.style.upload}", "borderWidth": "{border.width.hairline}"},
    "badge": {"radius": "{radius.full}"}
